# Copiar a .env para desarrollo local. El archivo .env NO se sube al repositorio.

# Clave para firmar el token Bearer (mínimo 32 caracteres). En Beanstalk va como
# propiedad de entorno. Generar una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Opcional. Sin esta variable se usa SQLite local (blacklist.db en la carpeta instance/).
# En Beanstalk la conexión a RDS va en RDS_HOSTNAME, RDS_PORT, RDS_DB_NAME, RDS_USERNAME y
# RDS_PASSWORD (propiedades del ambiente; ver docs/despliegue.md).
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/blacklist
